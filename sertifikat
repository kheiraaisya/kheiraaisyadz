<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Section Sertifikat</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --primary-color: #021A54;
    --secondary-color: #FFCEE3;
    --tersier-color: #FF85BB;
    --background-color: #F5F5F5;
    --text-color: #333333;
    --font-sans: "Poppins", sans-serif;
    --font-logo: "Montserrat", sans-serif;
    --text-gray: #6B7280;
    --abu-section: #F8FAFC;
    --garis-section: #E2E8F0;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:var(--font-sans);color:var(--text-color);background:var(--background-color)}
  .demo{height:40vh;display:grid;place-items:center;color:var(--text-gray);font-size:.9rem} /* demo saja, hapus */

  /* ====== SECTION SERTIFIKAT (salin dari sini) ====== */
  #sertifikat{background:#fff;border-top:1px solid var(--garis-section);border-bottom:1px solid var(--garis-section);padding:88px 24px}
  #sertifikat .wadah{max-width:1080px;margin:0 auto}
  #sertifikat .kepala{text-align:center;margin-bottom:28px}
  #sertifikat h2{margin:0 0 6px;font-size:2rem;font-weight:700;color:var(--primary-color)}
  #sertifikat .sub{margin:0 auto;max-width:52ch;line-height:1.7;color:var(--text-gray)}

  /* filter */
  .filter{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin:0 0 32px;padding:0;list-style:none}
  .filter button{
    font:500 .78rem var(--font-sans);padding:6px 16px;border-radius:999px;cursor:pointer;
    border:1px solid var(--garis-section);background:#fff;color:var(--primary-color);
    transition:background .2s,color .2s,border-color .2s;
  }
  .filter button:hover{border-color:var(--tersier-color);background:rgba(255,133,187,.16)}
  .filter button[aria-pressed="true"]{background:var(--primary-color);border-color:var(--primary-color);color:#fff}
  .filter button:focus-visible{outline:3px solid var(--tersier-color);outline-offset:2px}
  .filter .n{opacity:.6;margin-left:4px;font-weight:400}

  /* grid */
  .grid-sert{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .sert{
    display:flex;flex-direction:column;text-align:left;padding:10px 10px 16px;cursor:pointer;
    border-radius:16px;background:var(--abu-section);border:1px solid var(--garis-section);
    font-family:inherit;color:inherit;
    transition:transform .25s ease,border-color .25s ease;
  }
  .sert:hover{transform:translateY(-4px);border-color:var(--tersier-color)}
  .sert:focus-visible{outline:3px solid var(--tersier-color);outline-offset:3px}
  .sert[hidden]{display:none}

  .thumb{position:relative;aspect-ratio:4/3;border-radius:10px;overflow:hidden;background:var(--garis-section)}
  .thumb::after{content:"";position:absolute;inset:0;border-radius:inherit;box-shadow:inset 0 0 0 1px rgba(2,26,84,.14);pointer-events:none}
  .thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top center}
  .thumb .kosong{position:absolute;inset:0;display:grid;place-items:center;font-size:.72rem;color:var(--text-gray)}
  .thumb .lapis{
    position:absolute;inset:0;display:grid;place-items:center;
    background:rgba(255,133,187,.82);color:var(--primary-color);font-size:.8rem;font-weight:600;
    opacity:0;transition:opacity .25s ease;
  }
  .sert:hover .lapis,.sert:focus-visible .lapis{opacity:1}

  .info{padding:14px 6px 0;display:flex;flex-direction:column;gap:4px;flex:1}
  .info h3{margin:0;font-size:.92rem;font-weight:600;line-height:1.4;color:var(--primary-color)}
  .info .oleh{margin:0;font-size:.76rem;line-height:1.5;color:var(--text-gray)}
  .info .tag{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 0;padding:0;list-style:none}
  .info .tag li{padding:3px 11px;border-radius:999px;font-size:.68rem;font-weight:500;line-height:1.5;color:var(--primary-color);background:rgba(255,133,187,.16)}
  .info .tag li.thn{background:#fff;border:1px solid var(--garis-section)}

  /* tombol */
  .bawah{display:flex;justify-content:center;margin-top:32px}
  .btn{
    display:inline-block;padding:7px 20px;border-radius:999px;cursor:pointer;
    font:600 .76rem var(--font-sans);text-decoration:none;
    border:1.5px solid var(--primary-color);color:var(--primary-color);background:transparent;
    transition:background .2s,color .2s,border-color .2s;
  }
  .btn:hover,.btn:focus-visible{background:var(--primary-color);color:#fff}
  .btn:focus-visible{outline:3px solid var(--tersier-color);outline-offset:2px}
  .btn[hidden]{display:none}

  /* lightbox */
  .lb{position:fixed;inset:0;z-index:999;display:none;place-items:center;padding:24px;background:rgba(2,26,84,.82)}
  .lb.buka{display:grid}
  .lb figure{margin:0;max-width:min(920px,100%);max-height:100%;display:flex;flex-direction:column;gap:12px;align-items:center}
  .lb img{max-width:100%;max-height:78vh;border-radius:10px;background:#fff;object-fit:contain}
  .lb figcaption{color:#fff;font-size:.85rem;text-align:center;line-height:1.5}
  .lb figcaption small{display:block;color:var(--secondary-color);font-size:.74rem}
  .lb .tutup{
    position:absolute;top:16px;right:16px;width:38px;height:38px;border-radius:50%;cursor:pointer;
    border:1.5px solid #fff;background:transparent;color:#fff;font:400 1.2rem/1 var(--font-sans);
    transition:background .2s,color .2s;
  }
  .lb .tutup:hover,.lb .tutup:focus-visible{background:var(--tersier-color);border-color:var(--tersier-color);color:var(--primary-color)}

  @media (max-width:900px){.grid-sert{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:560px){
    #sertifikat{padding:64px 16px}
    .grid-sert{gap:12px}
    .sert{padding:8px 8px 14px}
    .info h3{font-size:.8rem}
    .info .oleh{font-size:.7rem}
  }
  @media (prefers-reduced-motion:reduce){.sert,.lapis{transition:none}.sert:hover{transform:none}}
</style>
</head>
<body>

<div class="demo">(konten sebelum section Sertifikat, yaitu Prestasi)</div>

<section id="sertifikat">
  <div class="wadah">
    <div class="kepala">
      <h2>Sertifikat</h2>
      <p class="sub">Pelatihan dan kursus yang pernah saya ikuti.</p>
    </div>

    <ul class="filter" id="filter-sert"></ul>
    <div class="grid-sert" id="grid-sert"></div>

    <div class="bawah">
      <button class="btn" id="lebih-sert" type="button">Tampilkan lebih banyak</button>
    </div>
  </div>

  <div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Sertifikat">
    <button class="tutup" type="button" aria-label="Tutup">&times;</button>
    <figure>
      <img id="lb-img" alt="">
      <figcaption id="lb-cap"></figcaption>
    </figure>
  </div>
</section>

<div class="demo">(konten sesudah section Sertifikat)</div>

<script>
(function () {
  /* ====== EDIT DATA DI SINI ======
     foto  : taruh file di folder foto/ (WebP/PNG/JPG)
     kat   : Pelatihan | Kursus | Sertifikasi (bebas, filter ikut otomatis)
     Data di bawah hanya contoh, ganti dengan sertifikatmu. */
  const DATA = [
    { judul: "Nama Pelatihan 1",  oleh: "Penyelenggara A", thn: "2025", kat: "Pelatihan", foto: "foto/sertif-1.webp" },
    { judul: "Nama Kursus 1",     oleh: "Platform B",      thn: "2025", kat: "Kursus",    foto: "foto/sertif-2.webp" },
    { judul: "Nama Pelatihan 2",  oleh: "Penyelenggara D", thn: "2024", kat: "Pelatihan", foto: "foto/sertif-4.webp" },
    { judul: "Nama Kursus 2",     oleh: "Platform E",      thn: "2024", kat: "Kursus",    foto: "foto/sertif-5.webp" },
    { judul: "Nama Pelatihan 3",  oleh: "Penyelenggara G", thn: "2023", kat: "Pelatihan", foto: "foto/sertif-7.webp" },
    { judul: "Nama Kursus 3",     oleh: "Platform H",      thn: "2023", kat: "Kursus",    foto: "foto/sertif-8.webp" }
  ];
  const AWAL = 6;   // jumlah kartu yang tampil dulu
  const TAMBAH = 6; // jumlah yang muncul tiap klik "Tampilkan lebih banyak"

  const grid = document.getElementById('grid-sert');
  const filterEl = document.getElementById('filter-sert');
  const btnLebih = document.getElementById('lebih-sert');
  const lb = document.getElementById('lb');
  const lbImg = document.getElementById('lb-img');
  const lbCap = document.getElementById('lb-cap');
  let aktif = 'Semua', batas = AWAL, pemicu = null;

  const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

  grid.innerHTML = DATA.map((d, i) => `
    <button class="sert" type="button" data-i="${i}" data-kat="${esc(d.kat)}" aria-label="Lihat sertifikat ${esc(d.judul)}">
      <div class="thumb">
        <span class="kosong">Foto sertifikat</span>
        <img src="${esc(d.foto)}" alt="Sertifikat ${esc(d.judul)}" loading="lazy" onerror="this.remove()">
        <span class="lapis">Lihat Sertifikat</span>
      </div>
      <div class="info">
        <h3>${esc(d.judul)}</h3>
        <p class="oleh">${esc(d.oleh)}</p>
        <ul class="tag"><li>${esc(d.kat)}</li><li class="thn">${esc(d.thn)}</li></ul>
      </div>
    </button>`).join('');
  const kartu = [...grid.children];

  const kategori = ['Semua', ...new Set(DATA.map(d => d.kat))];
  filterEl.innerHTML = kategori.map(k => {
    const n = k === 'Semua' ? DATA.length : DATA.filter(d => d.kat === k).length;
    return `<li><button type="button" data-k="${esc(k)}" aria-pressed="${k === aktif}">${esc(k)}<span class="n">${n}</span></button></li>`;
  }).join('');

  function tampil() {
    const cocok = kartu.filter(c => aktif === 'Semua' || c.dataset.kat === aktif);
    kartu.forEach(c => c.hidden = true);
    cocok.slice(0, batas).forEach(c => c.hidden = false);
    btnLebih.hidden = cocok.length <= batas;
  }

  filterEl.addEventListener('click', e => {
    const b = e.target.closest('button'); if (!b) return;
    aktif = b.dataset.k; batas = AWAL;
    filterEl.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', x === b));
    tampil();
  });
  btnLebih.addEventListener('click', () => { batas += TAMBAH; tampil(); });

  function buka(i) {
    const d = DATA[i];
    lbImg.src = d.foto; lbImg.alt = 'Sertifikat ' + d.judul;
    lbCap.innerHTML = `${esc(d.judul)}<small>${esc(d.oleh)} &middot; ${esc(d.thn)}</small>`;
    lb.classList.add('buka');
    lb.querySelector('.tutup').focus();
  }
  function tutup() {
    lb.classList.remove('buka'); lbImg.removeAttribute('src');
    if (pemicu) pemicu.focus();
  }
  grid.addEventListener('click', e => {
    const c = e.target.closest('.sert'); if (!c) return;
    pemicu = c; buka(+c.dataset.i);
  });
  lb.addEventListener('click', e => { if (e.target === lb || e.target.closest('.tutup')) tutup(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && lb.classList.contains('buka')) tutup(); });

  tampil();
})();
</script>
</body>
</html>